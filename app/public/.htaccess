# BEGIN WordPress
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /githubwp/

# Route git smart HTTP requests to handler
RewriteRule ^git/(.+)$ git-smart-http.php?git_route=$1 [L,QSA]

RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /githubwp/index.php [L]
</IfModule>
# END WordPress
